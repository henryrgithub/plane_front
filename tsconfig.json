{
  "extends": "./node_modules/gts/tsconfig-google.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "build",
    "lib": [
      "dom"
    ],
    "module": "ES6",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler"
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}
