{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plane",
  "description": "A plane for use in a simple simulator",
  "type": "object",
  "properties": {
    "created": "string",
    "updated": "string",
    "oneOf": [
      {
      "basicGeometry": {
        "type": "object",
        "properties": {
          "wingspanMeters": "number",
          "lengthMeters": "number",
          "chordMeters": "number"
        }
      }
      }
    ],
    "controlLoops": {
      "type": "array",
      "items": {
        "frequencyHz": "integer",
        "interrupts": {
          "anyOf": [
            {"pitch": "bool"},
            {"yaw": "bool"},
            {"roll": "bool"}
          ]
        }
      }
    }
  }
}

